# ==============================================================================
# BENUE MARKET — SUPABASE & APPLICATION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Duplicate this file to .env and replace placeholders with actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC FRONTEND SUPABASE CREDENTIALS (Vite Exposed)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_STORAGE_BUCKET=benue-market-media
VITE_SITE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. PRIVATE SERVER & ADMIN CREDENTIALS (SECRET)
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE CONNECTION STRINGS
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://postgres.[your-project-ref]:[your-db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgres://postgres.[your-project-ref]:[your-db-password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 4. APPLICATION METADATA
# ------------------------------------------------------------------------------
VITE_APP_NAME="Benue Market"
VITE_APP_TAGLINE="Buy. Sell. Connect."
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# 5. PAYSTACK PAYMENT INTEGRATION (Product Advertising)
# ------------------------------------------------------------------------------
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# ------------------------------------------------------------------------------
# 5A. PAYSTACK TEST KEYS (Development & Testing)
# ------------------------------------------------------------------------------
VITE_PAYSTACK_TEST_PUBLIC_KEY=pk_test_your_test_public_key_here
PAYSTACK_TEST_SECRET_KEY=sk_test_your_test_secret_key_here

# ------------------------------------------------------------------------------
# 5B. PAYSTACK LIVE KEYS (Production - Real ₦1,000 Charges)
# ------------------------------------------------------------------------------
VITE_PAYSTACK_LIVE_PUBLIC_KEY=pk_live_your_live_public_key_here
PAYSTACK_LIVE_SECRET_KEY=sk_live_your_live_secret_key_here

# ------------------------------------------------------------------------------
# 6. REAL EMAIL DELIVERY & PASSWORD RESET CONFIGURATION
# ------------------------------------------------------------------------------
# Option 1: Resend API (Recommended - 3,000 Free Emails/Month -> https://resend.com)
VITE_RESEND_API_KEY=re_your_resend_api_key_here

# Option 2: EmailJS API (Free Browser Direct Email Delivery -> https://emailjs.com)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Option 3: Supabase Dashboard Custom SMTP Provider
# Configure in: Supabase Dashboard -> Project Settings -> Authentication -> SMTP Settings
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_smtp_password_here
SMTP_SENDER_EMAIL=noreply@benuemarket.ng
SMTP_SENDER_NAME="Benue Market Security"
